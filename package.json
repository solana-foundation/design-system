{
    "name": "design-system",
    "private": true,
    "packageManager": "pnpm@11.5.2",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --cache --write .",
        "format:check": "prettier --cache --check .",
        "storybook": "turbo run storybook",
        "storybook:local": "pnpm --filter @solana/design-system storybook",
        "storybook:build": "turbo run storybook:build",
        "registry:build": "turbo run registry:build",
        "example:token-list": "turbo run dev --filter token-list-example",
        "changeset": "changeset",
        "changeset:version": "changeset version",
        "changeset:publish": "changeset publish"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "@eslint/js": "^9.39.4",
        "@solana/prettier-config-solana": "^0.0.6",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "turbo": "^2.9.16",
        "typescript-eslint": "^8.60.1"
    }
}
