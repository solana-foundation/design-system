{
  "name": "design-system",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "storybook": "turbo run storybook",
    "storybook:local": "pnpm --filter @solana/design-system storybook",
    "storybook:build": "turbo run storybook:build",
