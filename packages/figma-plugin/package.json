{
    "name": "@solana/figma-plugin",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "rm -rf dist && pnpm build:code && pnpm build:ui",
        "build:code": "esbuild src/code.ts --bundle --outfile=dist/code.js --format=iife --target=es2017",
        "build:ui": "vite build",
        "dev": "concurrently \"pnpm build:code --watch\" \"vite build --watch\""
    },
    "dependencies": {
        "@shikijs/core": "^3.2.0",
        "@shikijs/engine-javascript": "^3.2.0",
        "shiki": "^3.2.0"
    },
    "devDependencies": {
        "@figma/plugin-typings": "^1.100.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.4.0",
        "concurrently": "^9.2.1",
        "esbuild": "^0.24.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "typescript": "^5.7.0",
        "vite": "^6.0.0",
        "vite-plugin-singlefile": "^2.0.0"
    }
}
