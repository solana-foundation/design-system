{
    "name": "@solana/figma-plugin",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "rm -rf dist && pnpm build:code && pnpm build:ui",
        "build:code": "esbuild src/code.ts --bundle --outfile=dist/code.js --format=iife --target=es2017",
        "build:ui": "vite build",
        "dev": "concurrently \"pnpm build:code --watch\" \"vite build --watch\""
    },
    "dependencies": {
        "@shikijs/core": "^4.2.0",
        "@shikijs/engine-javascript": "^4.2.0",
        "shiki": "^4.2.0"
    },
    "devDependencies": {
        "@figma/plugin-typings": "^1.128.0",
        "@types/react": "^19.2.16",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "concurrently": "^10.0.3",
        "esbuild": "^0.28.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vite-plugin-singlefile": "^2.3.3"
    }
}
