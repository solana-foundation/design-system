{
    "name": "glass-design-system",
    "version": "0.0.0",
    "description": "Research-backed glass components and tokens for product UI.",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./displacement-map": {
            "types": "./dist/displacement-map.d.ts",
            "import": "./dist/displacement-map.js"
        },
        "./glass-filter": {
            "types": "./dist/glass-filter.d.ts",
            "import": "./dist/glass-filter.js"
        },
        "./glass-surface": {
            "types": "./dist/glass-surface.d.ts",
            "import": "./dist/glass-surface.js"
        },
        "./slider": {
            "types": "./dist/slider.d.ts",
            "import": "./dist/slider.js"
        },
        "./tokens": {
            "types": "./dist/tokens.d.ts",
            "import": "./dist/tokens.js"
        },
        "./styles.css": "./src/styles.css"
    },
    "files": [
        "dist",
        "src",
        "research"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "scripts": {
        "build": "vite build --config vite.config.lib.ts",
        "lint": "pnpm -w eslint packages/glass-design-system/src",
        "format": "pnpm -w prettier --cache --write packages/glass-design-system/src packages/glass-design-system/README.md packages/glass-design-system/package.json packages/glass-design-system/tsconfig.json packages/glass-design-system/tsconfig.build.json packages/glass-design-system/vite.config.lib.ts",
        "format:check": "pnpm -w prettier --cache --check packages/glass-design-system/src packages/glass-design-system/README.md packages/glass-design-system/package.json packages/glass-design-system/tsconfig.json packages/glass-design-system/tsconfig.build.json packages/glass-design-system/vite.config.lib.ts"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.16",
        "@types/react-dom": "^19.2.3",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "rollup-plugin-preserve-use-client": "^3.0.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vite-plugin-dts": "^5.0.2"
    }
}
