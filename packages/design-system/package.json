{
    "name": "@solana/design-system",
    "version": "1.0.0",
    "description": "Solana Design System - A collection of React components for building Solana applications",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./badge": {
            "types": "./dist/badge.d.ts",
            "import": "./dist/badge.js"
        },
        "./animated-icon": {
            "types": "./dist/animated-icon.d.ts",
            "import": "./dist/animated-icon.js"
        },
        "./button": {
            "types": "./dist/button.d.ts",
            "import": "./dist/button.js"
        },
        "./code-block": {
            "types": "./dist/code-block.d.ts",
            "import": "./dist/code-block.js"
        },
        "./code-block-group": {
            "types": "./dist/code-block-group.d.ts",
            "import": "./dist/code-block-group.js"
        },
        "./copy-button": {
            "types": "./dist/copy-button.d.ts",
            "import": "./dist/copy-button.js"
        },
        "./inline-code": {
            "types": "./dist/inline-code.d.ts",
            "import": "./dist/inline-code.js"
        },
        "./segmented-control": {
            "types": "./dist/segmented-control.d.ts",
            "import": "./dist/segmented-control.js"
        },
        "./select": {
            "types": "./dist/select.d.ts",
            "import": "./dist/select.js"
        },
        "./spinner": {
            "types": "./dist/spinner.d.ts",
            "import": "./dist/spinner.js"
        },
        "./table": {
            "types": "./dist/table.d.ts",
            "import": "./dist/table.js"
        },
        "./tabs": {
            "types": "./dist/tabs.d.ts",
            "import": "./dist/tabs.js"
        },
        "./text-input": {
            "types": "./dist/text-input.d.ts",
            "import": "./dist/text-input.js"
        },
        "./tooltip": {
            "types": "./dist/tooltip.d.ts",
            "import": "./dist/tooltip.js"
        },
        "./styles": "./src/defaults.css",
        "./defaults": "./src/defaults.css",
        "./base.css": "./src/base.css",
        "./utils": {
            "types": "./dist/utils/index.d.ts",
            "import": "./dist/utils/index.js"
        },
        "./hooks": {
            "types": "./dist/hooks/index.d.ts",
            "import": "./dist/hooks/index.js"
        },
        "./globals.css": "./src/globals.css",
        "./defaults.css": "./src/defaults.css"
    },
    "files": [
        "dist",
        "src",
        "registry.json"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "scripts": {
        "build": "vite build --config vite.config.lib.ts",
        "dev": "storybook dev --disable-telemetry -p 6006 --no-open",
        "storybook": "storybook dev --disable-telemetry -p 6006 --no-open",
        "storybook:build": "storybook build --disable-telemetry --output-dir storybook-static",
        "storybook:run": "npx serve storybook-static",
        "lint": "pnpm -w eslint packages/design-system",
        "lint:fix": "pnpm -w eslint packages/design-system --fix",
        "format": "pnpm -w prettier --cache --write .",
        "format:check": "pnpm -w prettier --cache --check .",
        "check:types": "pnpm build && pnpm -w --filter token-list-example typecheck && pnpm -w --filter vite-consumer-fixture typecheck",
        "check:bundles": "pnpm build && node ./scripts/check-bundle-isolation.mjs",
        "registry:build": "npx shadcn@latest build"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0",
        "tailwindcss": "^4.0.0",
        "@base-ui/react": "^1.1.0",
        "motion": "^12.26.0"
    },
    "dependencies": {
        "@heroicons/react": "^2.2.0",
        "@shikijs/core": "^3.2.1",
        "@shikijs/engine-oniguruma": "^3.2.1",
        "lucide-react": "^0.575.0",
        "shiki": "^3.2.1"
    },
    "devDependencies": {
        "@base-ui/react": "^1.1.0",
        "@storybook/addon-a11y": "10.2.13",
        "@storybook/addon-docs": "10.2.13",
        "@storybook/addon-links": "10.2.13",
        "@storybook/addon-themes": "10.2.13",
        "@storybook/react-vite": "10.2.13",
        "@tailwindcss/vite": "^4.1.18",
        "@types/dompurify": "^3.2.0",
        "@types/node": "^22.10.5",
        "@types/react": "^19.0.6",
        "@types/react-dom": "^19.0.2",
        "corner-smoothing": "^0.1.5",
        "dompurify": "^3.3.1",
        "motion": "^12.26.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "rollup-plugin-preserve-use-client": "^3.0.1",
        "storybook": "10.2.16",
        "tailwindcss": "^4.1.18",
        "typescript": "^5.9.3",
        "vite": "^6.0.7",
        "vite-plugin-dts": "^4.5.4"
    }
}
